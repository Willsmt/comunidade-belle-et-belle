// Schema da Comunidade Belle et Belle
// Contexto: Identidade & acesso

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums ----------

enum Papel {
  ADMIN
  GESTORA
  PARCERIA
  CLIENTE
}

enum StatusConta {
  PENDENTE
  ATIVO
  SUSPENSO
}

// ---------- domínio (nosso) + base do Auth.js ----------

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?

  status        StatusConta  @default(PENDENTE)
  papeis        UsuarioPapel[]
  consentimento Consentimento?

  aprovadoPor   String?
  aprovadoEm    DateTime?

  accounts      Account[]
  sessions      Session[]

  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  @@index([status])
}

model UsuarioPapel {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  papel     Papel
  criadoEm  DateTime @default(now())

  @@unique([userId, papel])
  @@index([papel])
}

model Consentimento {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @unique
  versaoTermo String
  aceitoEm    DateTime @default(now())
}

// ---------- tabelas exigidas pelo Auth.js v5 (adapter Prisma) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
