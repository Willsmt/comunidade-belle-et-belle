// Schema da Comunidade Belle et Belle
// Contexto: Identidade & acesso
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
// ---------- enums ----------
enum Papel {
  ADMIN
  GESTORA
  PARCERIA
  CLIENTE
}
enum StatusConta {
  PENDENTE
  ATIVO
  SUSPENSO
}
enum TipoPlano {
  TREINO
  DIETA
}
enum FrequenciaItem {
  DIARIO
  SEMANAL
}
enum TipoBonus {
  LIMIAR_DIARIO
  COMBO
  CATEGORIA_COMPLETA
}
enum TipoConquista {
  RANKING_SEMANAL
  RANKING_GERAL
  BONUS
}
// ---------- domínio (nosso) + base do Auth.js ----------
model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  status        StatusConta  @default(PENDENTE)
  papeis        UsuarioPapel[]
  consentimento Consentimento?
  aprovadoPor   String?
  aprovadoEm    DateTime?
  accounts      Account[]
  sessions      Session[]
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt
  // contexto Perfil
  perfil               Perfil?
  medidas              RegistroMedida[]
  fotosEvolucao        FotoEvolucao[]
  vinculosComoCliente  VinculoParceria[] @relation("VinculoCliente")
  vinculosComoParceria VinculoParceria[] @relation("VinculoParceria")
  planosRecebidos      PlanoRecebido[]   @relation("PlanosCliente")
  planosEnviados       PlanoRecebido[]   @relation("PlanosParceria")
  // contexto Desafios
  marcacoes             MarcacaoItem[]
  participacoesSurpresa ParticipacaoSurpresa[]
  conquistas            Conquista[]
  @@index([status])
}
model UsuarioPapel {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  papel     Papel
  criadoEm  DateTime @default(now())
  @@unique([userId, papel])
  @@index([papel])
}
model Consentimento {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @unique
  versaoTermo String
  aceitoEm    DateTime @default(now())
}
// ---------- tabelas exigidas pelo Auth.js v5 (adapter Prisma) ----------
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  @@unique([identifier, token])
}
// ---------- contexto: Perfil ----------
model Perfil {
  id               String   @id @default(cuid())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String   @unique
  bio              String?
  bioPublica       Boolean  @default(false)
  emblemasPublicos Boolean  @default(true)
  medidasPublicas  Boolean  @default(false)
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt
}
model RegistroMedida {
  id        String   @id @default(cuid())
  cliente   User     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String
  data      DateTime @default(now())
  peso      Decimal? @db.Decimal(5, 2)
  cintura   Decimal? @db.Decimal(5, 2)
  quadril   Decimal? @db.Decimal(5, 2)
  braco     Decimal? @db.Decimal(5, 2)
  coxa      Decimal? @db.Decimal(5, 2)
  criadoEm  DateTime @default(now())
  @@index([clienteId, data])
}
model FotoEvolucao {
  id        String   @id @default(cuid())
  cliente   User     @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String
  chave     String
  data      DateTime @default(now())
  publica   Boolean  @default(false)
  criadoEm  DateTime @default(now())
  @@index([clienteId, data])
}
model VinculoParceria {
  id          String   @id @default(cuid())
  cliente     User     @relation("VinculoCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId   String
  parceria    User     @relation("VinculoParceria", fields: [parceriaId], references: [id], onDelete: Cascade)
  parceriaId  String
  ativo       Boolean  @default(true)
  criadoPorId String
  criadoEm    DateTime @default(now())
  @@unique([clienteId, parceriaId])
  @@index([parceriaId, ativo])
  @@index([clienteId, ativo])
}
model PlanoRecebido {
  id           String    @id @default(cuid())
  cliente      User      @relation("PlanosCliente", fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId    String
  parceria     User      @relation("PlanosParceria", fields: [parceriaId], references: [id], onDelete: Cascade)
  parceriaId   String
  tipo         TipoPlano
  titulo       String?
  arquivoChave String
  enviadoEm    DateTime  @default(now())
  @@index([clienteId, enviadoEm])
}
// ---------- contexto: Desafios ----------
model Desafio {
  id                String   @id @default(cuid())
  titulo            String
  fraseMotivacional String?
  dataInicio        DateTime @db.Date
  dataFim           DateTime @db.Date
  ativo             Boolean  @default(true)
  categorias        CategoriaDesafio[]
  regrasBonus       RegraBonus[]
  desafiosSurpresa  DesafioSurpresa[]
  conquistas        Conquista[]
  criadoEm          DateTime @default(now())
  @@index([ativo])
}
model CategoriaDesafio {
  id         String   @id @default(cuid())
  desafio    Desafio  @relation(fields: [desafioId], references: [id], onDelete: Cascade)
  desafioId  String
  nome       String
  cor        String
  itens      ItemDesafio[]
  @@index([desafioId])
}
model ItemDesafio {
  id           String           @id @default(cuid())
  categoria    CategoriaDesafio @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  categoriaId  String
  descricao    String
  pontos       Int
  frequencia   FrequenciaItem   @default(DIARIO)
  marcacoes    MarcacaoItem[]
  combos       RegraBonus[]     @relation("ComboItens")
  @@index([categoriaId])
}
model MarcacaoItem {
  id        String      @id @default(cuid())
  item      ItemDesafio @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  cliente   User        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String
  data      DateTime    @db.Date
  criadoEm  DateTime    @default(now())
  @@unique([itemId, clienteId, data])
  @@index([clienteId, data])
}
model RegraBonus {
  id           String        @id @default(cuid())
  desafio      Desafio       @relation(fields: [desafioId], references: [id], onDelete: Cascade)
  desafioId    String
  tipo         TipoBonus
  pontosExtras Int
  limiarItens  Int?
  itensCombo   ItemDesafio[] @relation("ComboItens")
  categoriaId  String?
  criadoEm     DateTime      @default(now())
  @@index([desafioId])
}
model DesafioSurpresa {
  id               String   @id @default(cuid())
  desafio          Desafio  @relation(fields: [desafioId], references: [id], onDelete: Cascade)
  desafioId        String
  titulo           String
  descricao        String?
  pontos           Int
  exigeComprovacao Boolean  @default(false)
  criadoEm         DateTime @default(now())
  participacoes    ParticipacaoSurpresa[]
  @@index([desafioId])
}
model ParticipacaoSurpresa {
  id                 String    @id @default(cuid())
  desafioSurpresa    DesafioSurpresa @relation(fields: [desafioSurpresaId], references: [id], onDelete: Cascade)
  desafioSurpresaId  String
  cliente            User      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId          String
  fotoChave          String?
  validado           Boolean   @default(false)
  validadoPor        String?
  validadoEm         DateTime?
  criadoEm           DateTime  @default(now())
  @@unique([desafioSurpresaId, clienteId])
}
model Emblema {
  id         String      @id @default(cuid())
  nome       String
  descricao  String?
  icone      String?
  conquistas Conquista[]
  criadoEm   DateTime    @default(now())
}
model Conquista {
  id         String        @id @default(cuid())
  cliente    User          @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId  String
  desafio    Desafio       @relation(fields: [desafioId], references: [id], onDelete: Cascade)
  desafioId  String
  emblema    Emblema       @relation(fields: [emblemaId], references: [id])
  emblemaId  String
  tipo       TipoConquista
  referencia String?
  criadoEm   DateTime      @default(now())
  @@index([clienteId])
  @@index([desafioId])
}
