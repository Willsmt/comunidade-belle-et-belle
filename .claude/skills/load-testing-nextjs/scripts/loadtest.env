# Env da stack de teste de carga — preenchido para comunidade-belle-et-belle.
#
# O `.env`/`.env.local` real do projeto NUNCA é lido por esta skill — evita
# apontar carga pro banco de produção (Neon) ou gastar com R2/Google OAuth reais.

LOADTEST_ENV_CONFIGURED=1

# --- Banco de teste (Docker Compose local) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/comunidade_loadtest"

# --- Auth (NextAuth v5, adapter Prisma, sessão em banco) ---
AUTH_SECRET="loadtest-placeholder-secret-nao-usar-em-producao"
AUTH_URL="http://localhost:3100"
# Provider Google: placeholder é suficiente — o login real não é exercitado,
# o seed cria a sessão direto no banco (ver seed-load-test-users.ts).
AUTH_GOOGLE_ID="loadtest-placeholder"
AUTH_GOOGLE_SECRET="loadtest-placeholder"

# --- Storage (Cloudflare R2 via AWS SDK) ---
# Placeholders OBRIGATÓRIOS: variável ausente aqui seria preenchida pelo `.env`
# real do projeto (next build/start carregam .env para o que não está no
# ambiente). As páginas só geram URL assinada localmente (getSignedUrl, sem
# rede); nenhum upload/download real acontece no cenário padrão.
R2_ACCOUNT_ID="loadtestaccount"
R2_ACCESS_KEY_ID="loadtest-placeholder"
R2_SECRET_ACCESS_KEY="loadtest-placeholder"
R2_BUCKET_NAME="loadtest-bucket"

# --- Ajustes da stack ---
LOADTEST_APP_PORT=3100
LOADTEST_DB_PORT=5436
LOADTEST_DB_NAME=comunidade_loadtest
LOADTEST_MIGRATE_COMMAND="npx prisma migrate deploy"
LOADTEST_SERVER_CONFIG="next start, 1 instância local, sem CDN na frente"
